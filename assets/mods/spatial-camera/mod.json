{
  "protocol": "rpen-mod",
  "api": 1,
  "id": "spatial-camera",
  "name": {
    "zh-CN": "三维摄像机",
    "en-US": "Spatial Camera"
  },
  "version": "1.0.0",
  "author": "rpe-next",
  "description": {
    "zh-CN": "用全局事件控制摄像机 X/Y/Z、偏航、俯仰、画面倾斜和视角。提供拖拽取样与姿态过渡助手，支持缓动、撤销和 Next 谱面保存；可选择让游戏 UI 与背景跟随谱面。",
    "en-US": "Drive camera X/Y/Z, yaw, pitch, roll and field of view with global events. Includes drag sampling and a pose transition helper with easing, undo and Next chart saving; the game UI and background can follow the chart optionally."
  },
  "entry": "main.mjs",
  "conflicts": [
    "sky-dodge"
  ],
  "settings": {
    "assistant-key": {
      "type": "shortcut",
      "label": {
        "zh-CN": "打开摄像机过渡助手",
        "en-US": "Open the camera transition helper"
      },
      "default": "CTRL&ALT&C"
    },
    "quality": {
      "type": "select",
      "label": {
        "zh-CN": "透视画质",
        "en-US": "Perspective quality"
      },
      "default": "balanced",
      "options": {
        "economy": {
          "zh-CN": "流畅",
          "en-US": "Fast"
        },
        "balanced": {
          "zh-CN": "均衡",
          "en-US": "Balanced"
        },
        "sharp": {
          "zh-CN": "精细",
          "en-US": "Sharp"
        }
      }
    }
  }
}
