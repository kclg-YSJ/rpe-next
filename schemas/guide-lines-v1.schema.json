{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Re:PhiEdit Next editor guide lines v1 (rpeNextGuideLines)",
  "type": "array",
  "maxItems": 4096,
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": ["id", "startTime", "endTime", "start", "end"],
    "properties": {
      "id": { "type": "string", "minLength": 1, "maxLength": 128 },
      "startTime": { "$ref": "#/$defs/beat" },
      "endTime": { "$ref": "#/$defs/beat" },
      "start": { "type": "number" },
      "end": { "type": "number" },
      "keepSnapped": { "type": "boolean", "default": true },
      "easingType": { "type": "integer", "minimum": 1, "maximum": 29, "default": 1 },
      "easingLeft": { "type": "number", "default": 0 },
      "easingRight": { "type": "number", "default": 1 },
      "bezier": { "enum": [0, 1, false, true] },
      "bezierPoints": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
      "customEasing": { "$ref": "animation-curve-v1.schema.json" }
    }
  },
  "$defs": {
    "beat": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [{ "type": "integer" }, { "type": "integer" }, { "type": "integer", "minimum": 1 }],
      "items": false
    }
  },
  "$comment": "Runtime validation additionally requires unique ids and 0 <= startTime < endTime. Guide progress is linear in beats, independent of BPM and line bpmfactor. These are editor aids, not player events."
}
