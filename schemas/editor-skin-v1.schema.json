{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RPEN editor skin v1",
  "type": "object",
  "required": [
    "protocol",
    "version",
    "id",
    "name"
  ],
  "description": "Structural validation only. Package paths, resources, references, selectors and security require the RPEN importer. Unknown fields are ignored; use x- for metadata extensions.",
  "properties": {
    "protocol": {
      "const": "rpen-editor-skin"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "not": {
        "const": "default"
      }
    },
    "name": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "propertyNames": {
            "pattern": "^[A-Za-z]{2,3}(?:[-_][A-Za-z0-9]{2,8})*$"
          }
        }
      ]
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "propertyNames": {
            "pattern": "^[A-Za-z]{2,3}(?:[-_][A-Za-z0-9]{2,8})*$"
          }
        }
      ]
    },
    "colorScheme": {
      "enum": [
        "light",
        "dark"
      ],
      "default": "dark"
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "type"
        ],
        "oneOf": [
          {
            "required": [
              "path"
            ],
            "not": {
              "required": [
                "builtin"
              ]
            }
          },
          {
            "required": [
              "builtin"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "path"
                  ]
                },
                {
                  "required": [
                    "sources"
                  ]
                }
              ]
            }
          }
        ],
        "properties": {
          "type": {
            "enum": [
              "image",
              "font"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "builtin": {
            "enum": [
              "folder",
              "save",
              "setting",
              "help",
              "play",
              "replay",
              "showback",
              "jump",
              "copy",
              "shear",
              "paste",
              "delete0",
              "switch",
              "layout",
              "return",
              "info",
              "waves",
              "bezier",
              "addline",
              "mute"
            ]
          },
          "sources": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "path",
                "scale"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "scale": {
                  "type": "number",
                  "exclusiveMinimum": 1,
                  "maximum": 4
                }
              }
            }
          }
        }
      },
      "maxProperties": 256,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000,
        "description": "CSS declaration value; runtime validates the restricted syntax and asset/font/motion references."
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    },
    "styles": {
      "$ref": "#/$defs/rules"
    },
    "hide": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "description": "CSS selector, optionally using @component aliases. Must pass editorSkinSelector and browser selector validation."
      },
      "description": "Hide matching UI elements without deleting their functional nodes; no layout space or keyboard focus. Automatically restored on skin switch."
    },
    "motions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "description": "CSS declaration value; runtime validates the restricted syntax and asset/font/motion references."
          },
          "maxProperties": 100,
          "propertyNames": {
            "pattern": "^(--(skin|rpen)-[a-z0-9-]+|-?[a-z][a-z0-9-]*)$"
          }
        },
        "maxProperties": 40,
        "propertyNames": {
          "pattern": "^(from|to|100%|[0-9]{1,2}(\\.[0-9]+)?%)$"
        }
      },
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    },
    "organize": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": [
          "slot",
          "items"
        ],
        "properties": {
          "slot": {
            "enum": [
              "file-actions",
              "transport-actions",
              "editor-actions",
              "chart-tools",
              "toolbar",
              "inspector-tabs",
              "timeline-header",
              "footer"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "items": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "new",
                "open",
                "save",
                "export",
                "library",
                "migrate",
                "recover",
                "mods-open",
                "preferences",
                "help",
                "play",
                "rewind",
                "view-toggle",
                "undo",
                "redo",
                "copy",
                "cut",
                "paste",
                "mirror",
                "delete",
                "metadata",
                "bpm",
                "assets",
                "audio-analysis-tool",
                "noise-areas-tool",
                "curve-notes",
                "curve-trajectory",
                "text-lines-tool",
                "noise-fit-tool",
                "noise-tracking-tool",
                "multi-line-tool",
                "diagnose",
                "history-panel",
                "collaboration-tool",
                "version-control-tool",
                "seek",
                "notes-only",
                "game-ui",
                "reset-camera",
                "mute-current-line",
                "tools",
                "view-controls",
                "view-buttons",
                "line-controls",
                "beat-controls",
                "offset-control",
                "rate-control",
                "pitch-control",
                "time-readouts",
                "multi-line-controls",
                "tab-notes",
                "tab-events",
                "tab-lines",
                "tab-chart",
                "tab-noise",
                "tool-select",
                "tool-tap",
                "tool-hold",
                "tool-flick",
                "tool-drag",
                "global-events-tool"
              ]
            }
          },
          "direction": {
            "enum": [
              "row",
              "column"
            ],
            "default": "row"
          },
          "label": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "propertyNames": {
                  "pattern": "^[A-Za-z]{2,3}(?:[-_][A-Za-z0-9]{2,8})*$"
                }
              }
            ]
          },
          "collapsible": {
            "type": "boolean",
            "default": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "collapsible": {
                  "const": true
                }
              },
              "required": [
                "collapsible"
              ]
            },
            "then": {
              "required": [
                "label"
              ]
            }
          },
          {
            "if": {
              "anyOf": [
                {
                  "required": [
                    "label"
                  ]
                },
                {
                  "required": [
                    "direction"
                  ]
                },
                {
                  "required": [
                    "collapsible"
                  ]
                }
              ]
            },
            "then": {
              "required": [
                "id"
              ]
            }
          }
        ]
      }
    },
    "texts": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "required": [
          "selector"
        ],
        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "CSS selector, optionally using @component aliases. Must pass editorSkinSelector and browser selector validation."
          },
          "text": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "propertyNames": {
                  "pattern": "^[A-Za-z]{2,3}(?:[-_][A-Za-z0-9]{2,8})*$"
                }
              }
            ]
          },
          "title": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "propertyNames": {
                  "pattern": "^[A-Za-z]{2,3}(?:[-_][A-Za-z0-9]{2,8})*$"
