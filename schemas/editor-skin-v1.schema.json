    "canvas": {
      "type": "object",
      "properties": {
        "palette": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^(#[0-9a-fA-F]{6}|parameter\\([a-z][a-z0-9-]{0,63}\\))$",
            "description": "#rrggbb, or parameter(id) referencing a color parameter (API 3)."
          },
          "propertyNames": {
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "fontScale": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.8,
