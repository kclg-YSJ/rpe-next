{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Re:PhiEdit Next trajectory event payload v1",
  "type": "object",
  "required": ["version", "options", "segments"],
  "additionalProperties": true,
  "properties": {
    "version": { "const": 1 },
    "options": { "type": "object" },
    "segments": { "type": "integer", "minimum": 4, "maximum": 8192 },
    "split": { "type": "object" },
    "domain": {
      "description": "Ordered source progress interval; runtime additionally checks a < b.",
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "offsets": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "x": { "$ref": "#/$defs/offset" },
        "y": { "$ref": "#/$defs/offset" },
        "rotation": { "$ref": "#/$defs/offset" }
      }
    }
  },
  "$defs": { "offset": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } } }
}
