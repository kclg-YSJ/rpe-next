{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript"
  ],
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "assets/mods/**",
    "tmp-probe/**",
    ".kilo/**"
  ]
}
