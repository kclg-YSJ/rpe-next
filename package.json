{
  "name": "rpe-next",
  "version": "0.12.2",
  "private": true,
  "type": "module",
  "description": "Independent, incremental Re:PhiEdit reconstruction",
  "author": "cmdysj",
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://kclg-ysj.github.io/rpe-next/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kclg-YSJ/rpe-next.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "preview": "vite preview",
    "test": "node --test test/*.test.ts",
    "test:bun": "bun --bun run test",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:oxlint": "oxlint",
    "format:check": "oxfmt --check",
    "format": "oxfmt --write",
    "smoke-build": "node tools/smoke-build.ts",
    "smoke-build:bun": "bun tools/smoke-build.ts",
    "smoke-pages": "node tools/smoke-pages.ts",
    "smoke-pages:bun": "bun tools/smoke-pages.ts",
    "copy-assets": "node tools/copy-rpe-assets.ts",
    "copy-assets:bun": "bun tools/copy-rpe-assets.ts",
    "generate-easings": "node tools/generate-easings.ts",
    "generate-easings:bun": "bun tools/generate-easings.ts",
    "test:collaboration-server": "npm --prefix collaboration-server test",
    "test:collaboration-server:bun": "bun --bun run --cwd collaboration-server test",
    "build:collaboration-server": "node tools/build-collaboration-server.ts",
    "build:collaboration-server:bun": "bun tools/build-collaboration-server.ts",
    "benchmark": "node tools/benchmark.ts",
    "benchmark:bun": "bun tools/benchmark.ts",
    "audit": "node tools/audit.ts",
    "audit:bun": "bun tools/audit.ts",
    "verify-original": "node tools/audit.ts --verify",
    "verify-original:bun": "bun tools/audit.ts --verify",
    "compat": "node tools/compat.ts",
    "compat:bun": "bun tools/compat.ts",
    "legacy-audit": "node tools/legacy-audit.ts",
    "legacy-audit:bun": "bun tools/legacy-audit.ts",
    "migration-audit": "node tools/migration-audit.ts",
    "migration-audit:bun": "bun tools/migration-audit.ts",
    "scene-audit": "node tools/scene-audit.ts",
    "scene-audit:bun": "bun tools/scene-audit.ts",
    "build:desktop": "node tools/build-desktop.ts",
    "build:desktop:bun": "bun tools/build-desktop.ts",
    "build:release": "node tools/build-release.ts",
    "build:release:bun": "bun tools/build-release.ts",
    "desktop": "vite build && electron desktop/main.ts --dist"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "js-yaml": "^4.3.2",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "electron": "44.5.1",
    "eslint": "^9.39.5",
    "jiti": "^2.7.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.3",
    "vue-tsc": "^3.3.12",
    "yazl": "3.3.1"
  }
}
